# --- Puck page editor ---------------------------------------------------
# Neon Postgres connection string (Vercel: Storage > Neon, or neon.tech).
# Stores Puck page JSON. Without it, /about falls back to the in-repo seed
# and the editor cannot save.
DATABASE_URL=

# HTTP basic auth for /admin routes and Puck saves.
ADMIN_USER=
ADMIN_PASS=

# Vercel Blob token for image uploads in the editor (Vercel → Storage → Blob
# → create store; the token appears in the store's settings). The store must
# allow PUBLIC access — uploaded images are served directly on the site.
# Without a token the Upload button errors clearly; manual URLs still work.
BLOB_READ_WRITE_TOKEN=
